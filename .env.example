DATABASE_URL=postgresql://maitri:maitri@127.0.0.1:5433/maitri
SESSION_SECRET=change-me-to-a-long-random-string
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
NODE_ENV=development
WS_PORT=3001
# Browser WebSocket URL (optional; default = same host :3001)
# VITE_WS_URL=ws://127.0.0.1:3001
#
# Production (domain + Nginx /ws):
# NODE_ENV=production
# VITE_WS_URL=ws://pelegant.info/ws
# COOKIE_SECURE=0
# After HTTPS (certbot):
# VITE_WS_URL=wss://pelegant.info/ws
# COOKIE_SECURE=1

# Google OAuth (put real values in .env only — never commit secrets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local: http://localhost:8080/auth/callback
# Prod:  https://pelegant.info/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback

# Sign in with Apple (Services ID + .p8 key — never commit AuthKey_*.p8)
# Replace mock values with real ones from Apple Developer → Keys / Identifiers
APPLE_CLIENT_ID=info.pelegant.meetup.services
APPLE_TEAM_ID=7R8UFSHY4X
APPLE_KEY_ID=862F6KAWK8
# Prefer path locally; on servers you can paste PEM into APPLE_PRIVATE_KEY instead
APPLE_PRIVATE_KEY_PATH=./AuthKey_862F6KAWK8.p8
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Local / Prod redirect must match the Return URL registered on the Services ID
# Local:  http://localhost:8080/auth/callback
# Prod:   https://pelegant.info/auth/callback
APPLE_REDIRECT_URI=http://localhost:8080/auth/callback

