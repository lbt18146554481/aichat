DATABASE_URL=postgresql://maitri:maitri@127.0.0.1:5433/maitri
SESSION_SECRET=change-me-to-a-long-random-string
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
NODE_ENV=development
WS_PORT=3001
# Browser WebSocket URL (optional; default = same host :3001)
# VITE_WS_URL=ws://127.0.0.1:3001
#
# Production (domain + Nginx /ws):
# NODE_ENV=production
# VITE_WS_URL=ws://pelegant.info/ws
# COOKIE_SECURE=0
# After HTTPS (certbot):
# VITE_WS_URL=wss://pelegant.info/ws
# COOKIE_SECURE=1

# Google OAuth (put real values in .env only — never commit secrets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local: http://localhost:8080/auth/callback
# Prod:  https://pelegant.info/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback

